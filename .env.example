# ---- PRISM configuration (copy to .env and edit) ----

# Required: long random secret used to sign sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRISM_SECRET_KEY=

# Database (docker-compose builds PRISM_DATABASE_URL from these)
POSTGRES_USER=prism
POSTGRES_PASSWORD=
POSTGRES_DB=prism

# First administrator, created on first start when no users exist.
# Remove the password from this file after the first login.
PRISM_ADMIN_EMAIL=admin@example.la
PRISM_ADMIN_PASSWORD=

# Public hostname for automatic HTTPS (e.g. prism.company.la), or ":80" for plain HTTP on the LAN
PRISM_DOMAIN=:80
PRISM_HTTP_PORT=80
PRISM_HTTPS_PORT=443

# Optional: enables AI features (Blueprints from Phase 2, image table transcription)
ANTHROPIC_API_KEY=
PRISM_AI_MODEL=claude-sonnet-5-5

# Limits
PRISM_MAX_UPLOAD_MB=200
PRISM_TOKEN_TTL_MINUTES=720
PRISM_AUTH_RATE_PER_MINUTE=20
PRISM_TIMEZONE=Asia/Vientiane
PRISM_CORS_ORIGINS=[]
