# ---- PRISM configuration (copy to .env and edit) ----

# Required: long random secret used to sign sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRISM_SECRET_KEY=

# Database (docker-compose builds PRISM_DATABASE_URL from these)
POSTGRES_USER=prism
POSTGRES_PASSWORD=
POSTGRES_DB=prism

# First administrator, created on first start when no users exist.
# Remove the password from this file after the first login.
PRISM_ADMIN_EMAIL=admin@example.la
PRISM_ADMIN_PASSWORD=

# Public hostname for automatic HTTPS (e.g. prism.company.la), or ":80" for plain HTTP on the LAN
PRISM_DOMAIN=:80
PRISM_HTTP_PORT=80
PRISM_HTTPS_PORT=443

# AI interpretation for Blueprints. PRISM works without AI (deterministic rules); AI adds
# semantic insight. Whatever the model proposes is validated against the data, and the model
# never computes the numbers PRISM reports.
#   auto              Claude if ANTHROPIC_API_KEY is set, otherwise the local Ollama service
#   ollama            free local model (the ollama service in docker-compose); data stays on the server
#   openai_compatible any OpenAI-style API: DeepSeek, OpenRouter, LM Studio, vLLM…
#   anthropic         Claude (also used for image-table transcription)
#   none              rules only
PRISM_AI_PROVIDER=auto

# Local model. Choose by server hardware:
#   no GPU: qwen2.5:7b (slow: minutes per Blueprint) · ~16 GB GPU: a 27B-class Qwen model · 24 GB+: 30B+
PRISM_OLLAMA_MODEL=qwen2.5:7b
# maximum context window (each request is sized to its prompt)
PRISM_OLLAMA_NUM_CTX=32768

# OpenAI-compatible API (example: DeepSeek; data is sent to that provider)
PRISM_OPENAI_BASE_URL=
PRISM_OPENAI_API_KEY=
PRISM_OPENAI_MODEL=
# schema = json_schema response format; object = json_object (use for DeepSeek)
PRISM_OPENAI_JSON_MODE=schema

# Claude
ANTHROPIC_API_KEY=
PRISM_AI_MODEL=claude-opus-5-5
PRISM_AI_EFFORT=medium
# false = send only schema + statistics to the AI, never example values
PRISM_AI_SEND_VALUES=true

# Limits
PRISM_MAX_UPLOAD_MB=200
PRISM_TOKEN_TTL_MINUTES=720
PRISM_AUTH_RATE_PER_MINUTE=20
PRISM_TIMEZONE=Asia/Vientiane
PRISM_CORS_ORIGINS=[]
